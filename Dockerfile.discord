FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download 2>/dev/null || true
COPY . .
RUN go build -trimpath -ldflags "-s -w" -o /out/discord-bot ./cmd/discord

FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/discord-bot /app/discord-bot

# Outbound gateway connection only -- nothing listens, so no port and no healthcheck.
ENTRYPOINT ["/app/discord-bot"]
