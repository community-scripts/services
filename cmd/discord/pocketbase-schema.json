  {
    "name": "discord_issues",
    "type": "base",
    "listRule": null,
    "viewRule": null,
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "fields": [
      { "name": "guild_id", "type": "text", "required": true, "pattern": "^[0-9]{17,20}$" },
      { "name": "thread_id", "type": "text", "required": true, "pattern": "^[0-9]{17,20}$" },
      { "name": "message_id", "type": "text", "required": true, "pattern": "^[0-9]{17,20}$" },
      {
        "name": "repo",
        "type": "text",
